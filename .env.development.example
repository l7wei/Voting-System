# ==================================
# Firebase Configuration (Primary Database)
# ==================================
# Project ID (use "demo-voting-portal" for local emulator)
FIREBASE_PROJECT_ID=demo-voting-portal

# Firebase Emulator Hosts (for local development)
FIRESTORE_EMULATOR_HOST=localhost:8080
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Firebase Service Account Key (for production - JSON string)
# Leave empty for development (uses emulator)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# ==================================
# Auth Handshake Configuration
# ==================================
# Shared secret for VM proxy authentication
# Generate with: openssl rand -base64 32
AUTH_HANDSHAKE_API_KEY=local-dev-secret-key

# ==================================
# Legacy MongoDB (Optional - for migration period)
# ==================================
# Option 1: Use MongoDB URI (recommended for production)
# MONGODB_URI=mongodb://username:password@host:27017/database?authSource=admin

# Option 2: Use individual parameters (for development)
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_USERNAME=root
MONGO_PASSWORD=password
MONGO_NAME=voting_sa

# ==================================
# Application Settings
# ==================================
PORT=3000
NODE_ENV=development
# External hostname for the application (used for OAuth callbacks and links)
# For development, use localhost:3000 or your local IP
APP_HOSTNAME=localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ==================================
# Security - JWT Token Secret (Legacy)
# ==================================
# Generate a strong secret: openssl rand -base64 32
TOKEN_SECRET=change-this-to-a-strong-random-secret

# ==================================
# OAuth Configuration
# ==================================
OAUTH_CLIENT_ID=your-client-id
OAUTH_CLIENT_SECRET=your-client-secret
OAUTH_SCOPE=userid name inschool uuid

# Development: Mock OAuth (for local testing)
OAUTH_AUTHORIZE=http://localhost:3000/api/mock/auth
OAUTH_TOKEN_URL=http://localhost:3000/api/mock/token
OAUTH_RESOURCE_URL=http://localhost:3000/api/mock/resource
OAUTH_CALLBACK_URL=http://localhost:3000/api/auth/callback

# Production: CCXP OAuth (uncomment and configure for production)
# OAUTH_AUTHORIZE=https://oauth.ccxp.nthu.edu.tw/v1.1/authorize.php
# OAUTH_TOKEN_URL=https://oauth.ccxp.nthu.edu.tw/v1.1/token.php
# OAUTH_RESOURCE_URL=https://oauth.ccxp.nthu.edu.tw/v1.1/resource.php
# OAUTH_CALLBACK_URL=https://voting.nthusa.tw/api/auth/callback

