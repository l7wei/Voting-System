# Environment variables for NTHU OAuth Proxy
# Copy this file to .env and fill in the values

# NTHU OAuth Configuration
OAUTH_CLIENT_ID=your-client-id-here
OAUTH_CLIENT_SECRET=your-client-secret-here
OAUTH_TOKEN_URL=https://oauth.ccxp.nthu.edu.tw/v1.1/token.php
OAUTH_RESOURCE_URL=https://oauth.ccxp.nthu.edu.tw/v1.1/resource.php

# Cloud Run Configuration
CLOUD_RUN_API_URL=https://your-app.run.app
AUTH_HANDSHAKE_API_KEY=your-shared-secret-key-here

# Frontend Configuration
FRONTEND_URL=https://your-domain.com

# Server Configuration
PORT=8000
